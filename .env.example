# Copy this file to .env and fill in the tokens. .env is git-ignored and never packaged.
# The publish scripts read it; values already set in your environment win.
# How to create each token: see RELEASING.md.

# VS Code Marketplace: Azure DevOps personal access token with the "Marketplace > Manage" scope.
VSCE_PAT=

# Open VSX: access token from https://open-vsx.org/user-settings/tokens
# (only for publishing from this machine; the Release workflow can use trusted publishing)
OVSX_PAT=
