{
  "name": "where-was-i",
  "displayName": "Where Was I?",
  "description": "Visualizes the latest git commit code changes via soft background gradients.",
  "icon": "assets/extension_icon.ico",
  "publisher": "rajan694",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rajan694/Git-Commit-Code-Visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/Rajan694/Git-Commit-Code-Visualizer/issues"
  },
  "homepage": "https://github.com/Rajan694/Git-Commit-Code-Visualizer#readme",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "whereWasI.showInfoPopup",
        "title": "Where Was I: Settings Menu"
      },
      {
        "command": "whereWasI.toggleHighlights",
        "title": "Where Was I: Toggle Highlights"
      }
    ],
    "keybindings": [
      {
        "command": "whereWasI.toggleHighlights",
        "key": "ctrl+alt+w",
        "mac": "ctrl+alt+w"
      }
    ],
    "configuration": {
      "title": "Where Was I?",
      "properties": {
        "whereWasI.showDiffChanges": {
          "type": "boolean",
          "default": true,
          "description": "Toggle highlighting of recent git changes."
        },
        "whereWasI.diffColor": {
          "type": "string",
          "default": "#3f79c5",
          "enum": [
            "#3f79c5",
            "#4caf50",
            "#ff9800",
            "#e91e63",
            "#9c27b0"
          ],
          "enumDescriptions": [
            "Ocean Blue",
            "Mint Green",
            "Amber",
            "Rose",
            "Violet"
          ],
          "description": "Choose a preset color for the highlight."
        },
        "whereWasI.showYours": {
          "type": "boolean",
          "default": false,
          "description": "If true, only highlight lines if you are the author of the latest commit for the file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.102.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "ovsx": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
