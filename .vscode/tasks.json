// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"dependsOn": [
				"npm: watch:tsc",
				"npm: watch:esbuild"
			],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "watch:esbuild",
			"label": "npm: watch:esbuild",
			"group": "build",
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"reveal": "never"
			},
			// Matches the output of the problem-matcher plugin in esbuild.js,
			// so no extra problem-matcher extension is needed.
			"problemMatcher": {
				"owner": "esbuild",
				"fileLocation": "relative",
				"pattern": [
					{
						"regexp": "^✘ \\[ERROR\\] (.+)$",
						"message": 1
					},
					{
						"regexp": "^\\s+(.+):(\\d+):(\\d+):$",
						"file": 1,
						"line": 2,
						"column": 3
					}
				],
				"background": {
					"beginsPattern": "^\\[watch\\] build started",
					"endsPattern": "^\\[watch\\] build finished"
				}
			}
		},
		{
			"type": "npm",
			"script": "watch:tsc",
			"label": "npm: watch:tsc",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"type": "npm",
			"script": "watch-tests",
			"label": "npm: watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"watch",
				"npm: watch-tests"
			],
			"problemMatcher": []
		}
	]
}
